<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="openmrs-cce-emitter-adaptor"/>

    <property name="LOG_PATTERN" value="%d{ISO8601} [%thread] %-5level %logger{36} [%X{requestId:-}] [%X{resourceType:-}] [%X{resourceId:-}] - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <springProfile name="local | default">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="org.openphc.cce" level="DEBUG"/>
    </springProfile>

    <springProfile name="staging">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="production">
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="org.openphc.cce" level="INFO"/>
    </springProfile>
</configuration>
